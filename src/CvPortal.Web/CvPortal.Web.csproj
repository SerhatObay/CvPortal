<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CvPortal.Infrastructure\CvPortal.Infrastructure.csproj" />
    <ProjectReference Include="..\CvPortal.Application\CvPortal.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Yayın paketine yalnızca Türkçe (ve varsayılan İngilizce) kaynak dosyaları alınır; boyutu ciddi ölçüde küçültür. -->
    <SatelliteResourceLanguages>tr</SatelliteResourceLanguages>

    <!-- Ürün bilgisi: CvPortal.Web.exe → Özellikler → Ayrıntılar'da görünür. Yeni sürümde Version'ı artırın. -->
    <Version>1.0.0</Version>
    <Product>CvPortal</Product>
    <Description>Kişisel CV / portfolyo sitesi ve yönetim paneli</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Geliştirme ayarları ve çalışma zamanı verileri satış paketine girmesin. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

</Project>
