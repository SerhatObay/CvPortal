<?xml version="1.0" encoding="utf-8"?>
<!--
  Tam satış paketi: .NET çalışma ortamı uygulamanın içinde gelir (self-contained).
  Alıcının ayrıca .NET kurmasına gerek kalmaz; CvPortal.Web.exe'ye çift tıklamak yeterlidir.
  (IIS'te yayınlamak için IIS modülü yine "Hosting Bundle" ile kurulmalıdır.)
  Komut satırı: dotnet publish src/CvPortal.Web -p:PublishProfile=SatisPaketiTam
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- PublishUrl: Rider / Visual Studio, PublishDir: dotnet publish (komut satırı) -->
    <PublishUrl>..\..\artifacts\CvPortal-tam</PublishUrl>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\CvPortal-tam\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
  </PropertyGroup>
</Project>
