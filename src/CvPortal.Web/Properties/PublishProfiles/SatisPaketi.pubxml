<?xml version="1.0" encoding="utf-8"?>
<!--
  Satış paketi: Windows sunucu / IIS için klasöre yayın.
  Rider: CvPortal.Web → sağ tık → Publish → "SatisPaketi"
  Visual Studio: CvPortal.Web → sağ tık → Publish → SatisPaketi
  Komut satırı: dotnet publish src/CvPortal.Web -p:PublishProfile=SatisPaketi
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- PublishUrl: Rider / Visual Studio, PublishDir: dotnet publish (komut satırı) -->
    <PublishUrl>..\..\artifacts\CvPortal</PublishUrl>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\artifacts\CvPortal\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
  </PropertyGroup>
</Project>
