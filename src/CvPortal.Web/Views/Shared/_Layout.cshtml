<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="theme-color" content="#0b1120" />

    @* Tema tercihini sayfa çizilmeden uygula (yanıp sönmeyi önler) *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('cv-theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-bs-spy="scroll" data-bs-target="#mainNav" data-bs-root-margin="0px 0px -45%" tabindex="0">

    <nav id="mainNav" class="navbar navbar-expand-lg fixed-top site-nav">
        <div class="container">
            <a class="navbar-brand brand" href="#top">
                <span class="brand-mark">&lt;/&gt;</span>
                <span class="brand-text">@ViewData["BrandName"]</span>
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false" aria-label="Menüyü aç/kapat">
                <i class="bi bi-list fs-2"></i>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link" href="#about">Hakkımda</a></li>
                    <li class="nav-item"><a class="nav-link" href="#experience">Deneyim</a></li>
                    <li class="nav-item"><a class="nav-link" href="#skills">Yetenekler</a></li>
                    <li class="nav-item"><a class="nav-link" href="#projects">Projeler</a></li>
                    <li class="nav-item"><a class="nav-link" href="#education">Eğitim</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">İletişim</a></li>
                    <li class="nav-item d-flex gap-2 ms-lg-2 mt-2 mt-lg-0">
                        <button type="button" class="btn btn-icon" id="themeToggle" title="Temayı değiştir" aria-label="Temayı değiştir">
                            <i class="bi bi-moon-stars theme-icon-dark"></i>
                            <i class="bi bi-sun theme-icon-light"></i>
                        </button>
                        <button type="button" class="btn btn-icon" onclick="window.print()" title="Yazdır / PDF olarak kaydet" aria-label="Yazdır">
                            <i class="bi bi-printer"></i>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main id="top">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year @ViewData["BrandName"] · Tüm hakları saklıdır.</span>
            <span class="d-flex align-items-center gap-3">
                <span class="text-body-secondary small">Built with <i class="devicon-dotnetcore-plain"></i> .NET 10</span>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="footer-admin" title="Yönetim paneli">
                    <i class="bi bi-shield-lock"></i>
                </a>
            </span>
        </div>
    </footer>

    <button type="button" class="back-to-top" id="backToTop" aria-label="Yukarı çık"><i class="bi bi-arrow-up"></i></button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
