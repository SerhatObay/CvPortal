@model IReadOnlyList<ExperienceDto>

<section class="section section-alt" id="experience">
    <div class="container">
        <div class="section-heading reveal">
            <span class="section-kicker">02 · Deneyim</span>
            <h2>İş <span class="text-gradient">deneyimim</span></h2>
        </div>

        <div class="timeline">
            @foreach (var exp in Model)
            {
                <article class="timeline-item reveal @(exp.IsCurrent ? "is-current" : "")">
                    <div class="timeline-marker"></div>
                    <div class="timeline-card">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <h3 class="timeline-title">@exp.Position</h3>
                                <div class="timeline-company">
                                    @if (!string.IsNullOrWhiteSpace(exp.CompanyUrl))
                                    {
                                        <a href="@exp.CompanyUrl" target="_blank" rel="noopener">@exp.Company <i class="bi bi-box-arrow-up-right small"></i></a>
                                    }
                                    else
                                    {
                                        @exp.Company
                                    }
                                </div>
                            </div>
                            <div class="text-md-end">
                                <span class="period-badge">@exp.Period</span>
                                <div class="small text-body-secondary mt-1">@exp.Duration</div>
                            </div>
                        </div>

                        <div class="meta-row">
                            <span><i class="bi bi-geo-alt"></i> @exp.Location</span>
                            <span><i class="bi bi-clock"></i> @exp.EmploymentType.GetDisplayName()</span>
                            <span><i class="bi bi-house-gear"></i> @exp.WorkMode.GetDisplayName()</span>
                            @if (exp.IsCurrent)
                            {
                                <span class="badge-current">Halen çalışıyor</span>
                            }
                        </div>

                        <p class="mt-3 mb-2">@exp.Description</p>

                        @if (exp.Achievements.Count > 0)
                        {
                            <ul class="achievement-list">
                                @foreach (var item in exp.Achievements)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }

                        @if (exp.Technologies.Count > 0)
                        {
                            <div class="chips mt-3">
                                @foreach (var tech in exp.Technologies)
                                {
                                    <span class="chip">@tech</span>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
