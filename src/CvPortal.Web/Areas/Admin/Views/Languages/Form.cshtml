@model LanguageDto
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Dil" : "Dili Düzenle";
    ViewData["Subtitle"] = isNew ? "Konuştuğunuz bir dili ekleyin" : Model.Name;
}

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card admin-card">
                <div class="card-body">
                    <h6 class="card-section-title">Dil Bilgileri</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="İngilizce" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Level" class="form-label"></label>
                            <select asp-for="Level" asp-items="Html.GetEnumSelectList<LanguageLevel>()" class="form-select"></select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <partial name="_PublishFields" model="(Model.DisplayOrder, Model.IsVisible)" />
            <div class="mt-4"><partial name="_FormActions" model="isNew" /></div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
