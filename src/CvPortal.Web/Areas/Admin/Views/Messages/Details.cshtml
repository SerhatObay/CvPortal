@model ContactMessageDto
@{
    ViewData["Title"] = "Mesaj";
    ViewData["Subtitle"] = Model.Subject;
    var replySubject = Uri.EscapeDataString($"Re: {Model.Subject}");
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <a asp-action="Index" class="btn btn-light btn-sm mb-3"><i class="bi bi-arrow-left me-1"></i>Mesajlara dön</a>

        <div class="card admin-card">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                    <span class="avatar-lg">@DisplayHelpers.Initials(Model.Name)</span>
                    <div class="flex-grow-1">
                        <h5 class="fw-bold mb-0">@Model.Name</h5>
                        <a href="mailto:@Model.Email" class="small">@Model.Email</a>
                    </div>
                    <div class="text-end small text-body-secondary">
                        <div><i class="bi bi-calendar3 me-1"></i>@DisplayHelpers.LocalDateTime(Model.CreatedAt)</div>
                        @if (Model.ReadAt is { } readAt)
                        {
                            <div><i class="bi bi-check2-all me-1"></i>Okundu: @DisplayHelpers.Relative(readAt)</div>
                        }
                    </div>
                </div>

                <h4 class="fw-bold mb-3">@Model.Subject</h4>
                <div class="message-body">@Model.Message</div>
            </div>
            <div class="card-footer bg-transparent d-flex flex-wrap gap-2 p-3">
                <a href="mailto:@Model.Email?subject=@replySubject" class="btn btn-primary"><i class="bi bi-reply me-1"></i>E-posta ile yanıtla</a>
                <form asp-action="MarkUnread" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-light"><i class="bi bi-envelope me-1"></i>Okunmadı işaretle</button>
                </form>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="ms-auto" data-confirm="Bu mesaj kalıcı olarak silinecek.">
                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash3 me-1"></i>Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>
