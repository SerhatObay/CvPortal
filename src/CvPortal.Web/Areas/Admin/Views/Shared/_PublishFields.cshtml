@model (int DisplayOrder, bool IsVisible)
@* Sıra ve görünürlük alanları — tüm içerik formlarında ortak (yan panel) *@
<div class="card admin-card">
    <div class="card-body">
        <h6 class="card-section-title">Yayın Ayarları</h6>
        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" role="switch" id="IsVisible" name="IsVisible" value="true" @(Model.IsVisible ? "checked" : "") />
            <input type="hidden" name="IsVisible" value="false" />
            <label class="form-check-label" for="IsVisible">Sitede göster</label>
        </div>
        <label for="DisplayOrder" class="form-label">Sıra</label>
        <input type="number" class="form-control" id="DisplayOrder" name="DisplayOrder" value="@Model.DisplayOrder" min="0" />
        <div class="form-text">Küçük sayı önce gösterilir. 0 bırakılırsa en sona eklenir.</div>
    </div>
</div>
