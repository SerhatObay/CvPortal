@model bool
@* model: kayıt yeni mi? *@
<div class="form-actions">
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Listeye dön</a>
    <button type="submit" class="btn btn-primary px-4">
        <i class="bi bi-check2 me-1"></i>@(Model ? "Kaydet" : "Değişiklikleri kaydet")
    </button>
</div>
