@model RowActionsModel

<div class="row-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-action" title="Düzenle" aria-label="Düzenle">
        <i class="bi bi-pencil"></i>
    </a>
    <form asp-action="ToggleVisibility" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-action" title="@(Model.IsVisible ? "Siteden gizle" : "Sitede göster")" aria-label="Görünürlüğü değiştir">
            <i class="bi @(Model.IsVisible ? "bi-eye-slash" : "bi-eye")"></i>
        </button>
    </form>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="&quot;@Model.ItemName&quot; kalıcı olarak silinecek.">
        <button type="submit" class="btn btn-action btn-action-danger" title="Sil" aria-label="Sil">
            <i class="bi bi-trash3"></i>
        </button>
    </form>
</div>
