@using CvPortal.Application.Services.Interfaces
@inject IContactMessageService MessageService
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var unread = await MessageService.GetUnreadCountAsync();
    var userName = User.Identity?.Name ?? "Yönetici";
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · CvPortal Admin</title>
    <script>
        try { document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('cv-admin-theme') || 'light'); } catch (e) { }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.16.0/devicon.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <aside class="admin-sidebar" id="adminSidebar">
            <a asp-controller="Dashboard" asp-action="Index" class="sidebar-brand">
                <span class="brand-mark">&lt;/&gt;</span>
                <span>CvPortal <small>Admin</small></span>
            </a>

            <nav class="sidebar-nav">
                <span class="nav-section">Genel</span>
                <a asp-controller="Dashboard" asp-action="Index" class="@Active("Dashboard")"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                <a asp-controller="Profile" asp-action="Index" class="@Active("Profile")"><i class="bi bi-person-badge"></i> Profil</a>

                <span class="nav-section">CV İçeriği</span>
                <a asp-controller="Experiences" asp-action="Index" class="@Active("Experiences")"><i class="bi bi-briefcase"></i> Deneyimler</a>
                <a asp-controller="Educations" asp-action="Index" class="@Active("Educations")"><i class="bi bi-mortarboard"></i> Eğitim</a>
                <a asp-controller="Skills" asp-action="Index" class="@Active("Skills")"><i class="bi bi-cpu"></i> Yetenekler</a>
                <a asp-controller="Projects" asp-action="Index" class="@Active("Projects")"><i class="bi bi-kanban"></i> Projeler</a>
                <a asp-controller="Certificates" asp-action="Index" class="@Active("Certificates")"><i class="bi bi-patch-check"></i> Sertifikalar</a>
                <a asp-controller="Languages" asp-action="Index" class="@Active("Languages")"><i class="bi bi-translate"></i> Diller</a>

                <span class="nav-section">İletişim</span>
                <a asp-controller="Messages" asp-action="Index" class="@Active("Messages")">
                    <i class="bi bi-envelope"></i> Mesajlar
                    @if (unread > 0)
                    {
                        <span class="badge rounded-pill ms-auto nav-badge">@unread</span>
                    }
                </a>

                <span class="nav-section">Entegrasyon</span>
                <a href="/scalar/v1" target="_blank"><i class="bi bi-braces-asterisk"></i> API Dokümantasyonu <i class="bi bi-box-arrow-up-right ms-auto small opacity-50"></i></a>
            </nav>

            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="sidebar-footer-link">
                <i class="bi bi-eye"></i> Siteyi görüntüle
            </a>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="btn btn-icon d-lg-none" id="sidebarToggle" aria-label="Menüyü aç">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["Subtitle"] is string subtitle)
                    {
                        <p>@subtitle</p>
                    }
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-icon" id="adminThemeToggle" title="Temayı değiştir" aria-label="Temayı değiştir">
                        <i class="bi bi-moon"></i>
                    </button>
                    <a asp-controller="Messages" asp-action="Index" asp-route-unread="true" class="btn btn-icon position-relative" title="Okunmamış mesajlar">
                        <i class="bi bi-bell"></i>
                        @if (unread > 0)
                        {
                            <span class="notif-dot"></span>
                        }
                    </a>
                    <div class="dropdown">
                        <button class="user-chip dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar-sm">@DisplayHelpers.Initials(userName)</span>
                            <span class="d-none d-sm-inline">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Profil</a></li>
                            <li><a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index" target="_blank"><i class="bi bi-globe me-2"></i>Siteyi görüntüle</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @* Bildirimler *@
    <div class="toast-container position-fixed top-0 end-0 p-3">
        @if (TempData["Success"] is string success)
        {
            <div class="toast align-items-center border-0 toast-success" role="status" data-bs-delay="3500">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle-fill me-2"></i>@success</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast align-items-center border-0 toast-error" role="alert" data-bs-delay="5000">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div>
                    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        }
    </div>

    @* Silme onayı *@
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-4">
                    <div class="confirm-icon"><i class="bi bi-exclamation-triangle"></i></div>
                    <h5 class="fw-bold mt-3">Emin misiniz?</h5>
                    <p class="text-body-secondary mb-0" id="confirmMessage">Bu işlem geri alınamaz.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4 pt-0">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-danger px-4" id="confirmOk">Evet, sil</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
