@model IReadOnlyList<SkillDto>
@{
    ViewData["Title"] = "Yetenekler";
    ViewData["Subtitle"] = $"{Model.Count} yetenek · {Model.Select(x => x.Category).Distinct().Count()} kategori";
}

<div class="card admin-card">
    <div class="card-header-flex">
        <div class="d-flex gap-2 flex-wrap">
            <input type="search" class="form-control form-control-sm table-search" placeholder="Ara..." data-table-search="#skillTable" />
            <select class="form-select form-select-sm w-auto" data-table-filter="#skillTable" aria-label="Kategori filtresi">
                <option value="">Tüm kategoriler</option>
                @foreach (var category in Model.Select(x => x.CategoryName).Distinct())
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Yeni Yetenek</a>
    </div>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("Teknik ve kişisel yetkinliklerinizi ekleyin.")" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0" id="skillTable">
                <thead>
                    <tr>
                        <th>Yetenek</th>
                        <th>Kategori</th>
                        <th style="min-width:180px">Seviye</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsVisible ? "" : "row-muted")" data-filter-value="@item.CategoryName">
                            <td>
                                <span class="skill-icon"><i class="@(item.IconClass ?? "bi bi-code-slash")"></i></span>
                                <span class="fw-semibold ms-2">@item.Name</span>
                            </td>
                            <td><span class="category-badge">@item.CategoryName</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height:6px">
                                        <div class="progress-bar bg-gradient-accent" style="width:@(item.Proficiency)%"></div>
                                    </div>
                                    <span class="small text-body-secondary" style="width:80px">%@item.Proficiency · @item.LevelName</span>
                                </div>
                            </td>
                            <td><partial name="_StatusBadge" model="item.IsVisible" /></td>
                            <td class="text-end"><partial name="_RowActions" model="new RowActionsModel(item.Id, item.IsVisible, item.Name)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
