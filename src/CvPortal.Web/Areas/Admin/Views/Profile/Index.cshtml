@model ProfileDto
@{
    ViewData["Title"] = "Profil";
    ViewData["Subtitle"] = "Sitenin üst bölümünde ve iletişim alanında görünen bilgiler";
}

<form asp-action="Index" method="post" enctype="multipart/form-data" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card admin-card mb-4">
                <div class="card-body">
                    <h6 class="card-section-title">Temel Bilgiler</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="Senior Software Engineer" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Headline" class="form-label"></label>
                            <textarea asp-for="Headline" class="form-control" rows="2" data-counter="250"></textarea>
                            <span asp-validation-for="Headline" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="About" class="form-label"></label>
                            <textarea asp-for="About" class="form-control" rows="8" data-counter="4000"></textarea>
                            <div class="form-text">Paragrafları boş bir satırla ayırın.</div>
                            <span asp-validation-for="About" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CareerStartDate" class="form-label"></label>
                            <input asp-for="CareerStartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                            <div class="form-text">"Yıl deneyim" istatistiği bu tarihten hesaplanır.</div>
                            <span asp-validation-for="CareerStartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-md-3">
                                <input asp-for="IsOpenToWork" class="form-check-input" role="switch" />
                                <label asp-for="IsOpenToWork" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card admin-card">
                <div class="card-body">
                    <h6 class="card-section-title">İletişim & Sosyal Medya</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WebsiteUrl" class="form-label"></label>
                            <div class="input-group"><span class="input-group-text"><i class="bi bi-globe2"></i></span><input asp-for="WebsiteUrl" class="form-control" placeholder="https://" /></div>
                            <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="GitHubUrl" class="form-label"></label>
                            <div class="input-group"><span class="input-group-text"><i class="bi bi-github"></i></span><input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/..." /></div>
                            <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LinkedInUrl" class="form-label"></label>
                            <div class="input-group"><span class="input-group-text"><i class="bi bi-linkedin"></i></span><input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." /></div>
                            <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="MediumUrl" class="form-label"></label>
                            <div class="input-group"><span class="input-group-text"><i class="bi bi-medium"></i></span><input asp-for="MediumUrl" class="form-control" placeholder="https://medium.com/@@..." /></div>
                            <span asp-validation-for="MediumUrl" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card admin-card mb-4">
                <div class="card-body text-center">
                    <h6 class="card-section-title text-start">Profil Fotoğrafı</h6>
                    <img id="avatarPreview" src="@(string.IsNullOrWhiteSpace(Model.AvatarUrl) ? "/images/avatar.svg" : Model.AvatarUrl)" alt="Önizleme" class="avatar-preview" />
                    <div class="text-start mt-3">
                        <label for="avatarFile" class="upload-drop">
                            <i class="bi bi-cloud-arrow-up"></i>
                            <span><strong>Fotoğraf seçin</strong> veya buraya sürükleyin</span>
                            <small>JPG, PNG, WebP · en fazla 5 MB · kare fotoğraf önerilir</small>
                            <input type="file" id="avatarFile" name="avatarFile" accept="@MediaUploader.ImageAccept" data-file-preview="#avatarPreview" />
                        </label>
                        <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl) && Model.AvatarUrl != "/images/avatar.svg")
                        {
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="removeAvatar" name="removeAvatar" value="true" />
                                <label class="form-check-label small" for="removeAvatar">Fotoğrafı kaldır (varsayılan görsel kullanılır)</label>
                            </div>
                        }
                        <details class="mt-2 small">
                            <summary class="text-body-secondary">Gelişmiş: adres ile kullan</summary>
                            <input asp-for="AvatarUrl" class="form-control form-control-sm mt-2" data-preview="#avatarPreview" placeholder="https://..." />
                        </details>
                    </div>
                </div>
            </div>
            <div class="card admin-card mb-4">
                <div class="card-body">
                    <h6 class="card-section-title">CV Dosyası (PDF)</h6>
                    @if (!string.IsNullOrWhiteSpace(Model.CvFileUrl))
                    {
                        <a href="@Model.CvFileUrl" target="_blank" class="file-chip mb-3">
                            <i class="bi bi-file-earmark-pdf"></i>
                            <span>Mevcut CV'yi görüntüle</span>
                            <i class="bi bi-box-arrow-up-right ms-auto small"></i>
                        </a>
                    }
                    <label for="cvFile" class="upload-drop">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        <span><strong>PDF seçin</strong> veya buraya sürükleyin</span>
                        <small>En fazla 10 MB</small>
                        <input type="file" id="cvFile" name="cvFile" accept="@MediaUploader.PdfAccept" data-file-name="#cvFileName" />
                    </label>
                    <div id="cvFileName" class="small fw-semibold mt-1"></div>
                    <span asp-validation-for="CvFileUrl" class="text-danger small"></span>
                    @if (!string.IsNullOrWhiteSpace(Model.CvFileUrl))
                    {
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" id="removeCv" name="removeCv" value="true" />
                            <label class="form-check-label small" for="removeCv">CV dosyasını kaldır</label>
                        </div>
                    }
                    <div class="form-text">CV yüklenmezse sitede "PDF olarak kaydet" (yazdır) butonu gösterilir.</div>
                    <details class="mt-2 small">
                        <summary class="text-body-secondary">Gelişmiş: adres ile kullan</summary>
                        <input asp-for="CvFileUrl" class="form-control form-control-sm mt-2" placeholder="https://..." />
                    </details>
                </div>
            </div>
            @if (Model.UpdatedAt is { } updated)
            {
                <p class="small text-body-secondary"><i class="bi bi-clock-history me-1"></i>Son güncelleme: @DisplayHelpers.LocalDateTime(updated)</p>
            }
            <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-check2 me-1"></i>Profili kaydet</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
