@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Giriş · CvPortal Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="login-body">
    <div class="login-wrapper">
        <section class="login-hero d-none d-lg-flex">
            <div>
                <span class="brand-mark brand-mark-lg">&lt;/&gt;</span>
                <h1 class="mt-4">CvPortal<br />Yönetim Paneli</h1>
                <p class="lead">CV'nizin tüm içeriğini tek bir yerden yönetin.</p>
                <ul class="login-features">
                    <li><i class="bi bi-briefcase"></i> Deneyim, eğitim ve projeler</li>
                    <li><i class="bi bi-cpu"></i> Yetenek seviyeleri ve kategoriler</li>
                    <li><i class="bi bi-envelope-open"></i> İletişim formu mesajları</li>
                    <li><i class="bi bi-braces"></i> Harici paneller için REST API</li>
                </ul>
            </div>
        </section>

        <section class="login-form-side">
            <div class="login-card">
                <div class="d-lg-none mb-4"><span class="brand-mark">&lt;/&gt;</span></div>
                <h2 class="fw-bold mb-1">Tekrar hoş geldiniz 👋</h2>
                <p class="text-body-secondary mb-4">Devam etmek için giriş yapın.</p>

                <form asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary" id="togglePassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-box-arrow-in-right me-2"></i>Giriş yap</button>
                </form>

                <details class="small text-body-secondary mt-4">
                    <summary>Şifrenizi mi unuttunuz?</summary>
                    <p class="mt-2 mb-0">
                        Sunucuda uygulama klasöründe şu komutu çalıştırın:<br />
                        <code>CvPortal.Web.exe reset-password &lt;kullanıcı&gt; &lt;yeni-şifre&gt;</code><br />
                        Ayrıntılar için <code>KURULUM.md</code> dosyasına bakın.
                    </p>
                </details>

                <a asp-area="" asp-controller="Home" asp-action="Index" class="d-inline-block mt-4 small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Siteye dön
                </a>
            </div>
        </section>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('Password');
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            this.innerHTML = show ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        });
    </script>
</body>
</html>
