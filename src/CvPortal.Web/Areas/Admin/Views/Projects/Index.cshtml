@model IReadOnlyList<ProjectDto>
@{
    ViewData["Title"] = "Projeler";
    ViewData["Subtitle"] = $"{Model.Count} proje · {Model.Count(x => x.IsFeatured)} öne çıkan";
}

<div class="card admin-card">
    <div class="card-header-flex">
        <input type="search" class="form-control form-control-sm table-search" placeholder="Ara..." data-table-search="#projectTable" />
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Yeni Proje</a>
    </div>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("Kişisel veya profesyonel projelerinizi sergileyin.")" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0" id="projectTable">
                <thead>
                    <tr>
                        <th style="width:50px"></th>
                        <th>Proje</th>
                        <th class="d-none d-lg-table-cell">Teknolojiler</th>
                        <th>Bağlantılar</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsVisible ? "" : "row-muted")">
                            <td>
                                <form asp-action="ToggleFeatured" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-star @(item.IsFeatured ? "active" : "")" title="@(item.IsFeatured ? "Öne çıkanlardan kaldır" : "Öne çıkar")">
                                        <i class="bi @(item.IsFeatured ? "bi-star-fill" : "bi-star")"></i>
                                    </button>
                                </form>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Title</div>
                                <div class="small text-body-secondary">@DisplayHelpers.Truncate(item.Summary, 80)</div>
                            </td>
                            <td class="d-none d-lg-table-cell">
                                @foreach (var tech in item.Technologies.Take(3))
                                {
                                    <span class="tech-tag">@tech</span>
                                }
                                @if (item.Technologies.Count > 3)
                                {
                                    <span class="tech-tag tech-tag-more">+@(item.Technologies.Count - 3)</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                @if (!string.IsNullOrWhiteSpace(item.GitHubUrl))
                                {
                                    <a href="@item.GitHubUrl" target="_blank" rel="noopener" class="link-icon" title="GitHub"><i class="bi bi-github"></i></a>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.LiveUrl))
                                {
                                    <a href="@item.LiveUrl" target="_blank" rel="noopener" class="link-icon" title="Canlı demo"><i class="bi bi-box-arrow-up-right"></i></a>
                                }
                            </td>
                            <td><partial name="_StatusBadge" model="item.IsVisible" /></td>
                            <td class="text-end"><partial name="_RowActions" model="new RowActionsModel(item.Id, item.IsVisible, item.Title)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
