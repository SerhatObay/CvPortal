@model ExperienceDto
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Deneyim" : "Deneyimi Düzenle";
    ViewData["Subtitle"] = isNew ? "CV'nize yeni bir iş deneyimi ekleyin" : $"{Model.Position} · {Model.Company}";
}

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card admin-card">
                <div class="card-body">
                    <h6 class="card-section-title">Pozisyon Bilgileri</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Position" class="form-label"></label>
                            <input asp-for="Position" class="form-control" placeholder="Senior Software Engineer" />
                            <span asp-validation-for="Position" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Company" class="form-label"></label>
                            <input asp-for="Company" class="form-control" />
                            <span asp-validation-for="Company" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyUrl" class="form-label"></label>
                            <input asp-for="CompanyUrl" class="form-control" placeholder="https://" />
                            <span asp-validation-for="CompanyUrl" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label"></label>
                            <input asp-for="Location" class="form-control" placeholder="İstanbul" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmploymentType" class="form-label"></label>
                            <select asp-for="EmploymentType" asp-items="Html.GetEnumSelectList<EmploymentType>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="WorkMode" class="form-label"></label>
                            <select asp-for="WorkMode" asp-items="Html.GetEnumSelectList<WorkMode>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="card-section-title mt-4">İçerik</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" data-counter="2000"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="AchievementsText" class="form-label"></label>
                            <textarea asp-for="AchievementsText" class="form-control" rows="5" placeholder="Deploy süresini %80 azalttım.&#10;Test kapsamını %35'ten %80'e çıkardım."></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="TechnologiesText" class="form-label"></label>
                            <input asp-for="TechnologiesText" class="form-control" placeholder="C#, ASP.NET Core, PostgreSQL" data-tag-preview="#techPreview" />
                            <div id="techPreview" class="mt-2"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <partial name="_PublishFields" model="(Model.DisplayOrder, Model.IsVisible)" />
            <div class="mt-4"><partial name="_FormActions" model="isNew" /></div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
