@model IReadOnlyList<ExperienceDto>
@{
    ViewData["Title"] = "Deneyimler";
    ViewData["Subtitle"] = $"{Model.Count} kayıt · {Model.Count(x => x.IsVisible)} yayında";
}

<div class="card admin-card">
    <div class="card-header-flex">
        <input type="search" class="form-control form-control-sm table-search" placeholder="Ara..." data-table-search="#experienceTable" />
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Yeni Deneyim</a>
    </div>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("İş deneyimlerinizi ekleyerek CV'nizi oluşturmaya başlayın.")" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table admin-table align-middle mb-0" id="experienceTable">
                <thead>
                    <tr>
                        <th style="width:60px">Sıra</th>
                        <th>Pozisyon / Şirket</th>
                        <th>Tarih</th>
                        <th class="d-none d-lg-table-cell">Teknolojiler</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsVisible ? "" : "row-muted")">
                            <td><span class="order-pill">@item.DisplayOrder</span></td>
                            <td>
                                <div class="fw-semibold">@item.Position</div>
                                <div class="small text-body-secondary">@item.Company · @item.Location</div>
                            </td>
                            <td>
                                <div class="small">@item.Period</div>
                                <div class="small text-body-secondary">@item.Duration</div>
                            </td>
                            <td class="d-none d-lg-table-cell">
                                @foreach (var tech in item.Technologies.Take(3))
                                {
                                    <span class="tech-tag">@tech</span>
                                }
                                @if (item.Technologies.Count > 3)
                                {
                                    <span class="tech-tag tech-tag-more">+@(item.Technologies.Count - 3)</span>
                                }
                            </td>
                            <td><partial name="_StatusBadge" model="item.IsVisible" /></td>
                            <td class="text-end"><partial name="_RowActions" model="new RowActionsModel(item.Id, item.IsVisible, item.Position)" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
