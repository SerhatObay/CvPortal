{
  // =====================================================================
  //  CvPortal ayarları
  //  Kurulumda yalnızca "DefaultConnection" değerini kendi SQL Server'ınıza
  //  göre düzenlemeniz yeterlidir. Veritabanı ve tablolar ilk açılışta
  //  otomatik oluşturulur; yönetici hesabı /setup ekranından açılır.
  // =====================================================================

  "ConnectionStrings": {
    // Windows kimlik doğrulaması ile yerel SQL Server Express:
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=CvPortal;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"

    // SQL Server kullanıcı adı / şifresi ile (hosting firmaları genelde bunu verir):
    // "DefaultConnection": "Server=SUNUCU_ADRESI;Database=CvPortal;User Id=KULLANICI;Password=SIFRE;TrustServerCertificate=True;MultipleActiveResultSets=True"

    // LocalDB (yalnızca geliştirme):
    // "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CvPortal;Trusted_Connection=True;MultipleActiveResultSets=True"
  },

  "Database": {
    // "SqlServer" veya veritabanısız demo için "InMemory"
    "Provider": "SqlServer",
    // Açılışta tabloları oluşturur / günceller
    "AutoMigrate": true,
    // Veritabanı boşsa örnek CV içeriği ekler (kurulum sihirbazında silinebilir)
    "SeedDemoData": true
  },

  // Harici paneller (React, mobil vb.) için CORS izinleri.
  // API anahtarı veritabanında tutulur: Admin panel → Ayarlar.
  "Api": {
    "AllowedOrigins": []
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
